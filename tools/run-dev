def setup_routes(
    external_host: str, enable_help_center: bool, enable_help_center_dev_server: bool
) -> None:
    if enable_help_center:
        # Order of adding the rules matters. aiohttp will stop at the first
        # match, and we want `/help` to be matched before Django URIs.
        try:
            app.router.add_static("/help", "starlight_help/dist")
        except ValueError:
            print("""Please run the build step for the help center before enabling it.
The instructions for the build step can be found in the `./devtools`
page. `/help` urls will give you an error until you complete the
build step and rerun `run-dev`.""")
    elif enable_help_center_dev_server:

        async def redirect_help(request: web.Request) -> web.HTTPFound:
            return web.HTTPFound(request.url.with_port(help_center_port))

        app.add_routes(
            [
                web.route(hdrs.METH_ANY, r"/{path:(help).*}", redirect_help),
            ]
        )
    if options.rust_http_port is not None:
        rust_http_port = options.rust_http_port

        async def forward_compatibility(request: web.Request) -> web.StreamResponse:
            # The mobile compatibility check uses the canonical server host.
            port = rust_http_port if request.host.lower() == external_host.lower() else django_port
            return await forward(port, request)

        app.router.add_get("/compatibility", forward_compatibility)

        rust_routes: dict[str, set[str]] = {}
        read_methods = {hdrs.METH_GET, hdrs.METH_HEAD}
        if options.rust_alert_words:
            rust_routes["/api/v1/users/me/alert_words"] = read_methods
            rust_routes["/json/users/me/alert_words"] = read_methods
        if options.rust_saved_snippets or options.rust_saved_snippet_writes:
            snippet_methods = read_methods.copy() if options.rust_saved_snippets else set()
            if options.rust_saved_snippet_writes:
                snippet_methods.add(hdrs.METH_POST)
            rust_routes["/api/v1/saved_snippets"] = snippet_methods
        if options.rust_saved_snippets_web or options.rust_saved_snippets_web_writes:
            web_methods = read_methods.copy() if options.rust_saved_snippets_web else set()
            if options.rust_saved_snippets_web_writes:
                web_methods.add(hdrs.METH_POST)
            rust_routes["/json/saved_snippets"] = web_methods
        detail_methods: set[str] = set()
        if options.rust_saved_snippet_edits:
            detail_methods.add(hdrs.METH_PATCH)
        if options.rust_saved_snippet_deletes:
            detail_methods.add(hdrs.METH_DELETE)
        if detail_methods:
            rust_routes["/api/v1/saved_snippets/{snippet_id:[0-9]+}"] = detail_methods
        web_detail_methods: set[str] = set()
        if options.rust_saved_snippets_web_edits:
            web_detail_methods.add(hdrs.METH_PATCH)
        if options.rust_saved_snippets_web_deletes:
            web_detail_methods.add(hdrs.METH_DELETE)
        if web_detail_methods:
            rust_routes["/json/saved_snippets/{snippet_id:[0-9]+}"] = web_detail_methods
        if rust_routes:
            add_rust_routes(rust_http_port, rust_routes)

    app.add_routes(
        [
            web.route(
                hdrs.METH_ANY, r"/{path:json/events|api/v1/events}", partial(forward, tornado_port)
            ),
            web.route(hdrs.METH_ANY, r"/{path:webpack/.*}", partial(forward, webpack_port)),
            web.route(hdrs.METH_ANY, r"/{path:api/v1/tus/.*}", partial(forward, tusd_port)),
            web.route(hdrs.METH_ANY, r"/{path:.*}", partial(forward, django_port)),
        ]
    )


def add_rust_routes(rust_port: int, routes: dict[str, set[str]]) -> None:
    import django
    from django.conf import settings

    django.setup()
    from zerver.lib.subdomains import get_subdomain_from_hostname

    base_host = settings.EXTERNAL_HOST_WITHOUT_PORT.lower()
    subdomain_pattern = re.compile(r"[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?")

    def supports_rust_host(host: str) -> bool:
        host = host.lower()
        hostname = host.partition(":")[0]
        if hostname == base_host:
            rust_subdomain = ""
        else:
            subdomain = hostname.removesuffix("." + base_host)
            if subdomain == hostname or not subdomain_pattern.fullmatch(subdomain):
                return False
            rust_subdomain = "" if subdomain == "www" else subdomain
        # Preserve Django's realm selection for custom hosts and aliases.
        return get_subdomain_from_hostname(host) == rust_subdomain

    async def forward_route(methods: set[str], request: web.Request) -> web.StreamResponse:
        if request.method in methods and supports_rust_host(request.host):
            return await forward(rust_port, request, replace_real_ip=True)
        return await forward(django_port, request)

    for path, methods in routes.items():
        app.router.add_route(hdrs.METH_ANY, path, partial(forward_route, methods))


def print_listeners(external_host_url: str) -> None:
    if options.only_help_center:
        print(
            f"\n{CYAN}Help center dev server running on:{ENDC} {external_host_url}/help\nZulip web app and other related services will not run in this mode."
        )
        return

    print(f"\nStarting Zulip on:\n\n\t{CYAN}{external_host_url}/{ENDC}\n\nInternal ports:")
    ports = [
        (proxy_port, "Development server proxy (connect here)"),
        (django_port, "Django"),
        (tornado_port, "Tornado"),
    ]

    if not options.test:
        ports.append((webpack_port, "webpack"))

    if help_center_dev_server_enabled:
        ports.append((help_center_port, "Help center - Astro dev server"))

    if not options.streamlined:
        ports.append((tusd_port, "tusd"))

    for port, label in ports:
        print(f"   {port}: {label}")
    print()


runner: web.AppRunner | None = None
children: list["subprocess.Popen[bytes]"] = []


async def serve() -> None:
    global runner, session

    # Since we can't import settings from here, we duplicate some
    # EXTERNAL_HOST logic from dev_settings.py.
    IS_DEV_DROPLET = pwd.getpwuid(os.getuid()).pw_name == "zulipdev"
    if IS_DEV_DROPLET:
        # Technically, the `zulip.` is a subdomain of the server, so
        # this is kinda misleading, but 99% of development is done on
        # the default/zulip subdomain.
        default_hostname = "zulip." + os.uname()[1].lower()
    else:
        default_hostname = "localhost"

    external_host = os.getenv("EXTERNAL_HOST", f"{default_hostname}:{proxy_port}")
    http_protocol = "https" if options.behind_https_proxy else "http"
    external_host_url = f"{http_protocol}://{external_host}"

    if options.only_help_center:
        help_center_allowed_hosts = get_help_center_allowed_hosts()
        children.append(run_help_center_dev_server(help_center_allowed_hosts, proxy_port))
        print_listeners(external_host_url)
        return

    if options.test:
        do_one_time_webpack_compile()
    else:
        children.append(start_webpack_watcher())

    if help_center_dev_server_enabled:
        help_center_allowed_hosts = get_help_center_allowed_hosts()
        children.append(run_help_center_dev_server(help_center_allowed_hosts))

    setup_routes(external_host, options.help_center_static_build, options.help_center_dev_server)

    children.extend(subprocess.Popen(cmd) for cmd in server_processes())  # noqa: ASYNC220

    session = aiohttp.ClientSession()
    runner = web.AppRunner(app, auto_decompress=False, handler_cancellation=True)
    await runner.setup()
    site = web.TCPSite(runner, host=options.interface, port=proxy_port)
    try:
        await site.start()
    except OSError as e:
        if e.errno == errno.EADDRINUSE:
            print("\n\nERROR: You probably have another server running!!!\n\n")
        raise

    print_listeners(external_host_url)


loop = asyncio.new_event_loop()

try:
    loop.run_until_complete(serve())
    for s in (signal.SIGINT, signal.SIGTERM):
        loop.add_signal_handler(s, loop.stop)
    loop.run_forever()
finally:
    if runner is not None:
        loop.run_until_complete(runner.cleanup())
        loop.run_until_complete(session.close())

    for child in children:
        child.terminate()

    print("Waiting for children to stop...")
    for child in children:
        child.wait()

    # Remove pid file when development server closed correctly.
    os.remove(pid_file_path)
